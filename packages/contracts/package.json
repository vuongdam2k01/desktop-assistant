{
  "name": "@desktop-assistant/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "check": "tsx scripts/check.ts",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "yaml": "2.9.1"
  }
}
