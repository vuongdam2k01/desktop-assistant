# Environment files
.env
.env.*
!.env.example
.env.local
.env.*.local
secrets/*

# Build & runtime artifacts
node_modules/
dist/
build/
target/
release/
.turbo/
.vite/
coverage/
*.tsbuildinfo

# Native artifacts
native/*/target/
native/*/build/

# Logs
*.log
!**/evidence/**/*.log
__pycache__/
*.py[cod]

# Scratch & temporary logs
scratch/
.cli-logs/

# Database dumps never belong in the working tree; see apps/backend/src/cli/backup-location.ts
apps/backend/backups/

# Agent hook logs record real runs, including local paths
.claude/hooks/.logs/
.omp/hooks/.logs/

# Private keys and key bundles never belong in the repository, test material included
*.key
*.p12
*.pem
*.pfx

# Agent tooling. This repository publishes the application; the assistant
# configuration, skills, plugins and working notes stay local.
.claude/
.omp/
.agents/
.agentkit/
plugins/
CLAUDE.md
AGENTS.md
plans/

# Spike visual evidence is screen capture of a real working desktop. It is kept
# locally with the rest of the evidence and is not published; one full-screen
# capture was found to contain other people's names and internal conversation.
spikes/**/*.png
spikes/**/*.jpg
spikes/**/*.jpeg
spikes/**/*.gif
spikes/**/*.webp
spikes/**/*.bmp
spikes/**/*.tiff
spikes/**/*.pdf

# Documents describing the agent documentation tooling, which stays local with it
docs/da-plugin.md
docs/doc-model.md
docs/doc-workflow.md
docs/sdd-benchmark.md
