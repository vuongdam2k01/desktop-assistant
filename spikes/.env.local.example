# =====================================================================
#  ĐẦU VÀO CHO SPIKE — Desktop Assistant
# ---------------------------------------------------------------------
#  Copy file này thành .env.local rồi điền giá trị thật.
#  .env.local đã bị .gitignore loại trừ — không bao giờ commit.
#  Kiểm tra sau khi điền:  bash scripts/verify-inputs.sh
# =====================================================================


# ─────────────────────────────────────────────────────────────────────
#  1. LLM  —  BẮT BUỘC
#  Dùng bởi: SP-2, SP-4, SP-6, SP-8, SP-9, SP-10, SP-17
# ─────────────────────────────────────────────────────────────────────

# Base URL của endpoint OpenAI-compatible, KHÔNG có dấu / ở cuối.
# Thường kết thúc bằng /v1
LLM_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/coding/v3

LLM_API_KEY=

# Model chính cho worker-agent và undo-agent.
# Bắt buộc phải hỗ trợ TOOL CALLING — thiếu là SP-4, SP-6, SP-8 sụp.
LLM_MODEL_STRONG=

# Model rẻ/nhanh cho pet-agent và risk judge.
# Để trống nếu endpoint chỉ phơi ra một model — không spike nào bị chặn,
# chỉ mất phần so sánh của SP-10 và SP-17.
LLM_MODEL_CHEAP=

# Model có VISION, dùng để kiểm chứng đầu vào ảnh (FR-PET-04).
# Có thể trùng LLM_MODEL_STRONG. Để trống nếu không model nào có vision.
LLM_MODEL_VISION=


# ─────────────────────────────────────────────────────────────────────
#  2. NOTION  —  BẮT BUỘC
#  Dùng bởi: SP-1, SP-4, SP-9, SP-15
#
#  CHỈ CẦN TOKEN. Không cần điền page ID hay database ID — agent tự dò
#  bằng POST /v1/search và ghi kết quả ra spikes/fixtures/notion.json.
#
#  Lấy token: app.notion.com/developers/connections -> New connection
#             -> Authentication method = "Access token" (KHÔNG chọn OAuth)
#             -> mỗi connection gắn CỨNG một workspace, nên cần 3 cái
#
#  Notion tách quyền làm HAI TẦNG, phải cấp CẢ HAI:
#    1) Capabilities  (tab Configuration của connection)
#       bật: Read content + Update content + Insert content
#    2) Content access (tab Content access -> + Add pages & databases)
#       chọn ít nhất một page. Quyền thừa kế xuống toàn nhánh, gồm cả
#       thứ agent tạo ra về sau.
#    Thiếu tầng 2 thì token vẫn hợp lệ nhưng search trả về 0 đối tượng.
#
#  Ba workspace nên khác schema để SP-1 đo được sự khác biệt:
#    A: đơn giản (Title, Status, Due date)
#    B: phức tạp (thêm Assignee, Tags, Relation, Rollup, Formula)
#    C: có thứ tự (thêm Priority, Order dạng number)
#  Database do agent tạo — anh chỉ cần cấp quyền vào một page trống.
# ─────────────────────────────────────────────────────────────────────

NOTION_TOKEN_A=
NOTION_TOKEN_B=
NOTION_TOKEN_C=

# ─────────────────────────────────────────────────────────────────────
#  3. GOOGLE  —  cần cho SP-13 (bỏ trống được nếu hoãn SP-13)
#
#  client_id / client_secret KHÔNG để ở đây — chúng nằm trong file
#  secrets/google-oauth-client.json tải từ Cloud Console.
# ─────────────────────────────────────────────────────────────────────

# Địa chỉ Gmail đã được thêm vào danh sách Test users của consent screen.
GOOGLE_TEST_USER_EMAIL=

# true  = dùng hộp thư thật, chỉ đọc (kết quả SP-4/SP-13 sát thực tế hơn)
# false = dùng tài khoản Gmail test có dữ liệu mồi
# Lưu ý: nội dung email sẽ đi qua LLM provider ở LLM_BASE_URL.
GOOGLE_USE_REAL_MAILBOX=
