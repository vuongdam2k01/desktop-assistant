# Desktop Assistant Backend - Environment Configuration
# WARNING: Values labeled UNVERIFIED are developmental placeholders and not empirical thresholds.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
ENFORCE_TLS=false
TRUST_PROXY=false

# Database Store (PostgreSQL)
DATABASE_URL=postgresql://postgres:devpassword@127.0.0.1:54320/desktop_assistant_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=2000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Redis (Shared rate-limiting & OAuth bindings)
REDIS_URL=redis://127.0.0.1:63790
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_MAX_RETRIES=3

# Google Sign-In Identity
GOOGLE_SIGN_IN_CLIENT_ID=dev-google-sign-in-client-id

# JWT Session Tokens
JWT_ISSUER=desktop-assistant-backend
JWT_AUDIENCE=desktop-assistant-client
JWT_KEY_RING_SECRET_REF=JWT_KEY_RING
JWT_KEY_RING={"currentKid":"k1","keys":{"k1":"dev-signing-key-minimum-256-bits-length-for-hmac-sha256-safety"}}
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Provider Descriptors & Outbound Requests
PROVIDER_DESCRIPTOR_DIRECTORY=config/providers
PROVIDER_REQUEST_TIMEOUT_MS=10000

# Provider Secrets (resolved by SecretResolver from env)
NOTION_CLIENT_ID=dev-notion-client-id
NOTION_CLIENT_SECRET=dev-notion-client-secret
GOOGLE_OAUTH_CLIENT_ID=dev-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=dev-google-oauth-client-secret

# Static Update Feed
UPDATE_FEED_ROOT=update-feed

# Application Version Discovery
APP_CURRENT_VERSION=0.1.0
APP_MINIMUM_SUPPORTED_VERSION=0.1.0
APP_UPDATE_MANDATORY=false
# APP_MANIFEST_URI=https://updates.example.invalid/updates/latest.yml
# APP_RELEASE_NOTES_URI=https://example.invalid/notes/0.1.0

# Rate Limiting Classes (UNVERIFIED developmental defaults)
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_PUBLIC_TIME_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_TIME_WINDOW_MS=60000
RATE_LIMIT_BROKER_MAX=30
RATE_LIMIT_BROKER_TIME_WINDOW_MS=60000

# Replication Port (F22 owned, false until F22 present)
REPLICATION_ENABLED=false
